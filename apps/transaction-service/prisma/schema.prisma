// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
   binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  transactionExternalId    String   @id @unique @map("transaction_external_id")
  accountExternalIdDebit   String   @map("account_external_id_debit")
  accountExternalIdCredit  String   @map("account_external_id_credit")
  value                    Float    @map("value")
  status                   String   @map("status")
  transferTypeId           Int   @map("transfer_type_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("transactions")
}
